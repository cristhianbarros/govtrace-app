# Variables del monitoreo externo (ops/monitoring/gatus.yaml). Copiar a
# monitor.env en la máquina del monitor — fuera del servidor de GovTrace — y
# completar. monitor.env no se versiona: lleva la contraseña del correo.
GOVTRACE_HEALTH_URL=https://govtrace.example.org/up
# Chequeo cada minuto; alerta tras 6 fallas seguidas: más de 5 minutos caído (US-044-MON).
MONITOR_INTERVAL=1m
MONITOR_FAILURE_THRESHOLD=6
MONITOR_WEBHOOK_URL=
MONITOR_EMAIL_FROM=monitor@govtrace.example.org
MONITOR_EMAIL_TO=superadmin@govtrace.example.org
MONITOR_SMTP_HOST=
MONITOR_SMTP_PORT=587
MONITOR_SMTP_USERNAME=
MONITOR_SMTP_PASSWORD=
# true solo para un servidor de correo de prueba con certificado propio.
MONITOR_SMTP_INSECURE=false
