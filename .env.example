APP_NAME=GovTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://govtrace.localhost:8080
TENANCY_CENTRAL_DOMAINS=govtrace.localhost,localhost,127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=govtrace
DB_USERNAME=govtrace
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Evidence object storage (config/filesystems.php "evidencias" disk, D2).
# MinIO locally: same S3 API, path-style endpoint, container hostname.
EVIDENCE_AWS_ACCESS_KEY_ID=govtrace
EVIDENCE_AWS_SECRET_ACCESS_KEY=secretsecret
EVIDENCE_AWS_DEFAULT_REGION=us-east-1
EVIDENCE_AWS_BUCKET=evidencias
EVIDENCE_AWS_ENDPOINT=http://storage:4566
EVIDENCE_AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# --- Stellar / Soroban (it. 12) ---------------------------------------------
# `make contract-deploy` fills these for the local standalone network. Only
# PUBLIC values live here: no secret key ever goes in .env.example (R-BLK-04);
# how production keys are held is decision D11 in specs/PLAN.md.
STELLAR_RPC_URL=http://stellar:8000/rpc
STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
STELLAR_SEALING_CONTRACT_ID=
STELLAR_SEALER_ADDRESS=
STELLAR_SPONSOR_ADDRESS=
# Secret keys: filled in YOUR local .env by `make contract-deploy` (dev
# accounts from friendbot). Always empty here.
STELLAR_SEALER_SECRET=
STELLAR_SPONSOR_SECRET=
# HMAC key for the veedor pseudonym sealed in the metadata (R-PRIV-03, D7).
# Empty = derived from APP_KEY. Set it in production and never change it:
# a new key means new pseudonyms for the same veedores.
SEALING_PSEUDONYM_KEY=
