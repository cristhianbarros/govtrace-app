# Producción (it. 37a). Plantilla SIN secretos: los valores vacíos marcados
# "gestor de secretos" se inyectan como variables de entorno al arrancar
# (D11); nunca se escriben aquí ni en el repositorio (R-BLK-04). La lista de
# salida completa está en docs/go-live.md.

APP_NAME=GovTrace
APP_ENV=production
APP_KEY=                                # gestor de secretos (php artisan key:generate, una vez)
APP_DEBUG=false
APP_URL=https://govtrace.example
TENANCY_CENTRAL_DOMAINS=govtrace.example
TENANCY_APEX_DOMAIN=govtrace.example     # cada organización: <subdominio>.govtrace.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=govtrace
DB_USERNAME=govtrace
DB_PASSWORD=                            # gestor de secretos

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=                          # gestor de secretos
MAIL_FROM_ADDRESS="alertas@govtrace.example"
MAIL_FROM_NAME="${APP_NAME}"

# Archivos de evidencia (D2): un bucket S3 real, fuera del servidor.
EVIDENCE_AWS_ACCESS_KEY_ID=
EVIDENCE_AWS_SECRET_ACCESS_KEY=         # gestor de secretos
EVIDENCE_AWS_DEFAULT_REGION=us-east-1
EVIDENCE_AWS_BUCKET=
EVIDENCE_AWS_ENDPOINT=
EVIDENCE_AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Stellar, red principal (R-CFG-01, D13) ----------------------------------
# El RPC lo da un proveedor (QuickNode o Validation Cloud), con dos endpoints:
# el privado, del servidor, y uno de solo lectura restringido al dominio de
# GovTrace, para el validador del navegador. La aplicación no arranca si
# falta el público o si es el mismo que el privado.
STELLAR_RPC_URL=                        # endpoint privado del proveedor
STELLAR_PUBLIC_RPC_URL=                 # endpoint de solo lectura, restringido al dominio
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# Los escribe make network-deploy NETWORK=mainnet (.env.mainnet.deploy):
STELLAR_SEALING_CONTRACT_ID=
STELLAR_SEALER_ADDRESS=
STELLAR_SPONSOR_ADDRESS=
# Siempre vacías aquí: gestor de secretos (D11). La de la tesorería no va:
# Laravel no la usa (D12).
STELLAR_SEALER_SECRET=
STELLAR_SPONSOR_SECRET=
STELLAR_SPONSOR_MIN_BALANCE_XLM=2
STELLAR_EXPLORER_URL=
# Obligatoria en producción, y nunca cambia (D7, R-PRIV-03).
SEALING_PSEUDONYM_KEY=                  # gestor de secretos

# --- Monitoreo y costos (it. 32) ---------------------------------------------
ALERT_WEBHOOK_URL=
XLM_PRICE_API_URL=https://api.coingecko.com/api/v3/simple/price
COINGECKO_API_KEY=
