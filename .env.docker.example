# Variables for the DOCKER environment (read by docker compose via the Makefile).
# NOT the Laravel .env: no real credential goes here.
# Copy to .env.docker (the Makefile does it if missing) and adjust.

# --- Host user identity (id -u / id -g) -----------------------------------
PUID=1000
PGID=1000
TZ=UTC

# --- Publishing -----------------------------------------------------------
# 127.0.0.1 + *.localhost resolves without editing /etc/hosts.
# Use another loopback IP (e.g. 127.0.0.60) to run next to other projects
# on the same ports; then run 'make hosts'.
LOCAL_IP=127.0.0.1
HTTP_PORT=8080       # http://govtrace.localhost:8080
PG_PORT=5432         # DBeaver / TablePlus -> 127.0.0.1:5432

# --- Local database -------------------------------------------------------
# Development values; must match DB_* in the Laravel .env.
DB_DATABASE=govtrace
DB_USERNAME=govtrace
DB_PASSWORD=secret

# --- Object storage (S3 of development: versitygw, it. 45d) ----------------
# Keeps the evidence files on disk (volume evidence_files). Its keys and the
# bucket must match EVIDENCE_AWS_* in the Laravel .env (the defaults do).
MINIO_BUCKET=evidencias
MINIO_PORT=9000       # host port -> container's S3 API (4566)
#STORAGE_ACCESS_KEY_ID=govtrace
#STORAGE_SECRET_ACCESS_KEY=secretsecret

# --- Backups (service "backup", it. 35) -------------------------------------
# Every database and the evidence bucket, at start and every hour, kept 30
# days in the backup_data volume (docs/restore.md). In production point the
# S3 variables at the real bucket and keep that volume on another disk.
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=3600
#BACKUP_S3_ENDPOINT=              # empty = AWS S3 itself; default: the development S3
#BACKUP_AWS_ACCESS_KEY_ID=        # read-only access to the bucket is enough
#BACKUP_AWS_SECRET_ACCESS_KEY=
# Off-site replica (it. 37a): each copy is replicated to another bucket, in
# another account or region. Empty = no replica. That bucket needs versioning
# and a rule keeping noncurrent versions 30 days (docs/restore.md).
#BACKUP_OFFSITE_S3_URL=s3://govtrace-respaldos
#BACKUP_OFFSITE_S3_ENDPOINT=      # empty = AWS S3 itself
#BACKUP_OFFSITE_AWS_ACCESS_KEY_ID=
#BACKUP_OFFSITE_AWS_SECRET_ACCESS_KEY=

# --- Stellar local network (profile "stellar", it. 12) ---------------------
# Host port for the standalone network's RPC and friendbot (make stellar-up).
STELLAR_PORT=8100     # http://127.0.0.1:8100/rpc (8000 is a common dev port)

# --- Network --------------------------------------------------------------
# Change if a VPN publishes colliding routes. Check:
#   ip route get 172.29.0.2     -> must leave through br-*, not the VPN iface
DOCKER_NETWORK=govtrace_net
DOCKER_SUBNET=172.29.0.0/24
DOCKER_MTU=1500

# Network for the RUN steps of `docker build` (apt, curl, cargo...). They use
# Docker's default bridge (docker0, 172.17.0.0/16), and a VPN that publishes
# routes inside that range breaks them silently: no DNS, no internet. Check:
#   ip route get 172.17.0.2     -> if it leaves through the VPN iface (ppp0, tun0...), keep "host"
# "host" works with or without a VPN; "default" is Docker's usual behavior.
DOCKER_BUILD_NETWORK=host
