# Producción y staging (it. 42a): nginx es el borde. El TLS termina aquí, con un
# certificado comodín: ${DOMAIN} y *.${DOMAIN}, porque cada organización es un
# subdominio. Plantilla de la imagen oficial de nginx: al arrancar se completa
# con las variables del entorno (DOMAIN, y PUBLIC_PORT_SUFFIX: vacío con el 443
# de producción; ":18443" en make staging-check).

# Sin esto, nginx guarda la IP del contenedor al arrancar y falla si Docker le da otra.
resolver 127.0.0.11 ipv6=off valid=10s;

# El mismo límite que post_max_size en docker/app/php-prod.ini.
client_max_body_size 64M;
server_tokens off;

# It. 45f: el registro de acceso guarda solo la ruta de cada petición, sin sus
# parámetros ($uri y no $request ni $request_uri): si una URL llevara la
# ubicación del veedor u otro dato, no quedaría anotada con la hora y la IP.
# Cada server lo declara: un access_log en el http de la imagen se sumaría.
# It. 45g: tampoco los tokens. El del enlace para restablecer la contraseña va en
# la ruta, y el de una invitación puede volver en el Referer de lo que su página
# carga: los dos se enmascaran.
map $uri $govtrace_log_uri {
    ~^/reset-password/.  "/reset-password/[token]";
    default              $uri;
}
map $http_referer $govtrace_log_referer {
    ~/(set|reset)-password/  "[enlace con token]";
    default                  $http_referer;
}
# It. 42c: mientras un despliegue reemplaza la app, nginx no tiene a quién pasarle
# la visita (un 502). Responde 503 con docker/proxy/maintenance: la página en
# español, o el JSON para la app del veedor, cuya bandeja de salida guarda el
# reporte y lo reintenta.
map $http_accept $govtrace_maintenance {
    ~*application/json  /mantenimiento.json;
    default             /mantenimiento.html;
}

log_format govtrace '$remote_addr - $remote_user [$time_local] "$request_method $govtrace_log_uri $server_protocol" '
                    '$status $body_bytes_sent "$govtrace_log_referer" "$http_user_agent"';

# HTTP: solo lleva a HTTPS, con el mismo host (el subdominio de la organización).
server {
    listen 80 default_server;
    server_name ${DOMAIN} *.${DOMAIN};
    access_log /var/log/nginx/access.log govtrace;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host${PUBLIC_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${DOMAIN} *.${DOMAIN};
    access_log /var/log/nginx/access.log govtrace;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # La configuración "intermediate" de Mozilla: TLS 1.2 y 1.3, y cifrados con
    # secreto hacia adelante (ECDHE).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    error_page 502 504 =503 @mantenimiento;

    location @mantenimiento {
        root /usr/share/nginx/govtrace;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
        try_files $govtrace_maintenance =503;
    }

    location / {
        set $upstream_app app:80;
        proxy_pass http://$upstream_app;

        # El Host con que la aplicación reconoce a cada organización: el que nginx
        # ya validó contra server_name, y el puerto público si no es el 443.
        proxy_set_header Host              $host${PUBLIC_PORT_SUFFIX};
        proxy_set_header X-Real-IP         $remote_addr;
        # El borde: cualquier X-Forwarded-For del visitante se descarta.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # It. 41: nadie les cree, y además se borran.
        proxy_set_header X-Forwarded-Host  "";
        proxy_set_header X-Forwarded-Port  "";

        proxy_read_timeout      120s;
        proxy_send_timeout      120s;
        proxy_request_buffering off;
    }
}
