# Prueba de humo en la testnet de Stellar (it. 14, make smoke-testnet).
#
# D11: las llaves se inyectan como variables de entorno, nunca se versionan.
# En desarrollo, `make testnet-setup` crea cuentas de prueba, despliega el
# contrato y escribe .env.testnet (fuera de git). En CI lo escribe Jenkins
# desde sus credenciales. Aquí las llaves van SIEMPRE vacías.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_SEALING_CONTRACT_ID=
STELLAR_SEALER_ADDRESS=
STELLAR_SPONSOR_ADDRESS=
STELLAR_SEALER_SECRET=
STELLAR_SPONSOR_SECRET=
